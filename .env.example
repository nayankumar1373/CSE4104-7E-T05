# Copy this file to .env.local and fill in your own values. Never commit real keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (Supabase PostgreSQL, used by Prisma)
DATABASE_URL=
DIRECT_URL=

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payment sandbox (SSLCommerz or bKash)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=

# Monitoring
SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
